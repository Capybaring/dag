{
  "data_config": {
    "feature_dict": {"if_univariate": false},
    "data_set_name": "large_forecast"
  },
  "model_config": {
    "models": [{
      "model_name": "dag.DAG",
      "model_hyper_params": {
        "seq_len": 168, "horizon": 24, "norm": true,
        "alpha": 0.9, "batch_size": 64, "d_ff": 128, "d_model": 64,
        "dropout": 0.0, "e_layers": 1, "infer_use_future": 0,
        "loss": "MAE", "lr": 0.001, "lradj": "type3", "n_heads": 4,
        "num_epochs": 50, "patch_len": 48, "patience": 5, "stride": 48,
        "use_c": 1, "use_c_exog": 1, "use_t": 1, "use_t_exog": 1
      }
    }],
    "recommend_model_hyper_params": {
      "input_chunk_length": 168, "output_chunk_length": 24, "norm": true
    }
  },
  "evaluation_config": {
    "metrics": "all",
    "strategy_args": {
      "strategy_name": "rolling_forecast", "horizon": 24,
      "tv_ratio": 0.8, "train_ratio_in_tv": {"__default__": 0.875},
      "stride": 1, "num_rollings": 48000, "seed": 2021,
      "deterministic": "efficient", "save_true_pred": false,
      "target_channel": [9, 10, 11, 12, 13, 14, 15, 16, 17]
    }
  },
  "report_config": {
    "aggregate_type": "mean",
    "report_metrics": ["mse_norm", "mae_norm", "rmse_norm", "mape_norm", "smape_norm", "wape_norm", "msmape_norm"],
    "fill_type": "mean_value", "null_value_threshold": "0.3"
  }
}
